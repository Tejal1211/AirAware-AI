# Copy to backend/.env (never commit the real file).
# Optional: without a key the assistant answers from built-in deterministic rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated browser origins allowed to call the API (dev server by default)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits and tuning
MAX_UPLOAD_MB=5
UPSTREAM_TIMEOUT_S=10
AIR_CACHE_TTL_S=600
RATE_LIMIT_ENABLED=1
PORT=5000
FLASK_DEBUG=0
